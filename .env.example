# Configuración del servidor FastAPI
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# Configuración de ADB Custom Server
CUSTOM_ADB_PORT=5037

# Configuración de Automatización YouTube
# Número de cuentas por dispositivo
CUENTAS_POR_DISPOSITIVO=5

# Paquete de Chrome (puente hacia YouTube nativo)
CHROME_PACKAGE=com.android.chrome

# Retención por defecto para views (% de duración del video)
RETENTION_MIN_PCT=30
RETENTION_MAX_PCT=100

# Configuración del servicio de comentarios con DeepSeek
# Clave de API de DeepSeek (obligatoria para comentarios con IA)
DEEPSEEK_API_KEY=TU_API_KEY_AQUI
# Endpoint base (opcional)
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
# Modelo a utilizar
DEEPSEEK_MODEL=deepseek-chat
# Temperatura (0-1)
DEEPSEEK_TEMPERATURE=0.65
# Máximo de tokens por respuesta
DEEPSEEK_MAX_TOKENS=2000
# Tamaño de lote de dispositivos por request
DEEPSEEK_BATCH_SIZE=8
# Idioma principal de los comentarios
DEEPSEEK_LANGUAGE=es
# Tono sugerido
DEEPSEEK_TONE=conversacional
# Longitud máxima de cada comentario
DEEPSEEK_COMMENT_MAX_LENGTH=180
